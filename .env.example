# LLM API Keys (at least one required)
# DeepSeek (recommended default — cheapest for Indian users)
DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=your-openai-api-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Groq (fast inference)
GROQ_API_KEY=your-groq-api-key

# Google Gemini
GOOGLE_API_KEY=your-google-api-key

# Data Provider (optional)
# Financial Datasets API (paid, better fundamentals data for US stocks)
# Leave empty to default to yfinance (free, NSE/BSE coverage)
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# Zerodha Kite Connect (optional — live data and live portfolio)
# Create an app at https://developers.kite.trade to get these.
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret
# Access tokens expire every morning (~6 AM IST). Prefer `hedgefund login`,
# which writes .kite_session.json; set this only for CI/automation.
# KITE_ACCESS_TOKEN=your-kite-access-token
